{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Group Docker base image updates into a single PR",
      "matchManagers": ["dockerfile"],
      "groupName": "docker base images"
    }
  ]
}